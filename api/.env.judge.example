# Optional settings for the LOCAL ASP.NET API. Keep disabled until an existing
# Judge0 service is available; this project no longer starts a Judge0 Docker stack.
# MySQL uses the existing Database__* / ConnectionStrings__Database settings.
Judge__Enabled=false
Judge__BaseUrl=http://127.0.0.1:2358/
Judge__ApiToken=

# For the containerized API in docker-compose.production.yml:
# JUDGE_ENABLED=true
# JUDGE_BASE_URL=http://host.docker.internal:2358/
# JUDGE_API_TOKEN=your-existing-judge0-token-at-least-32-characters
