# Merge into your existing local environment; do not commit real keys.
Ai__Enabled=true
Ai__BaseUrl=http://127.0.0.1:8000/
Ai__ServiceKey=replace-with-at-least-32-random-characters
Ai__AnonymizationKey=use-a-separate-random-key-at-least-32-characters
Judge__Enabled=true

# Compose variables for the ai/rag profiles (same service key as Python):
AI_SERVICE_KEY=
AI_ANONYMIZATION_KEY=
AI_REDIS_URL=
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=
LLM_ADVANCED_MODEL=
LLM_BASE_URL=https://api.openai.com/v1

# Enable only after applying the LearningRagOutbox migration and configuring Python RAG.
Rag__Enabled=false
Rag__IndexBaseUrl=http://127.0.0.1:8001/
# Dev: docker compose --profile rag up -d --build; set Rag__Enabled=true in local API.
# Production: use .env.production.example with COMPOSE_PROFILES=rag,
# AI_ENABLED=true and RAG_ENABLED=true. Only docker-compose.production.yml is needed.
QDRANT_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024
EMBEDDING_API_KEY=
RAG_MIN_SCORE=0.35
