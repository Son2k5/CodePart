# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=codepath
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<YOUR_DATABASE_PASSWORD>
DATABASE_URL=Host=localhost;Port=5432;Database=codepath;Username=postgres;Password=<YOUR_DATABASE_PASSWORD>
ConnectionStrings__Database=Host=localhost;Port=5432;Database=codepath;Username=postgres;Password=<YOUR_DATABASE_PASSWORD>

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
ConnectionStrings__Redis=localhost:6379,abortConnect=false

# Staging/Production must use an authenticated Redis connection supplied by the
# deployment secret manager. Passwordless Redis is rejected outside Development.

# JWT Configuration (SigningKey must be at least 64 characters)
Jwt__Issuer=CodePath.Api
Jwt__Audience=CodePath.Client
Jwt__SigningKey=<YOUR_64_CHARACTER_RANDOM_SECRET_KEY>
Jwt__AccessTokenExpiryMinutes=15

# Production SMTP (required outside Development/Testing)
Email__Smtp__Host=smtp.example.com
Email__Smtp__Port=587
Email__Smtp__Username=<YOUR_SMTP_USERNAME>
Email__Smtp__Password=<YOUR_SMTP_PASSWORD>
Email__Smtp__FromAddress=no-reply@example.com
Email__Smtp__FromName=CodePath
Email__Smtp__SocketOptions=StartTls

# Distributed account lockout
AuthSecurity__Login__MaxFailures=5
AuthSecurity__Login__FailureWindowMinutes=15
AuthSecurity__Login__LockoutMinutes=15

# ASP.NET Core Hosting
# Do not set ASPNETCORE_ENVIRONMENT in this file. Production is the safe default;
# the local launch profile explicitly selects Development before .env is loaded.
ASPNETCORE_URLS=http://localhost:5000

# Configure only the exact subnet of your trusted reverse proxy when one is used.
# ReverseProxy__KnownNetworks__0=172.20.0.0/16

# CORS Allowed Origins
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://localhost:5173

# Judge0 must run as an isolated service. Never execute student code in the API process.
CodeExecution__Judge0__BaseUrl=http://localhost:2358
CodeExecution__Judge0__RequestTimeoutSeconds=20
# CodeExecution__Judge0__AuthenticationHeader=X-Auth-Token
# CodeExecution__Judge0__AuthenticationToken=<YOUR_JUDGE0_TOKEN>

# Refresh-token session policy. Use None only for a genuinely cross-site frontend;
# Secure cookies and the API origin check remain enabled.
AuthSession__CookieSameSite=Strict
AuthSession__CleanupIntervalHours=24
AuthSession__ExpiredTokenRetentionDays=30

# Admin Seed Passwords (Required to seed admin accounts on startup)
ADMIN01_PASSWORD=<YOUR_ADMIN01_PASSWORD>
ADMIN01_EMAIL=admin01@hanu.edu.vn
ADMIN01_FULLNAME=System Administrator 01

ADMIN02_PASSWORD=<YOUR_ADMIN02_PASSWORD>
ADMIN02_EMAIL=admin02@hanu.edu.vn
ADMIN02_FULLNAME=System Administrator 02
