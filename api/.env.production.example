# Production Compose settings. Copy to .env.production (gitignored).
# Existing database/Redis/JWT/SMTP/TLS secrets remain in ./secrets.
# Optional AI/RAG environment keys below are secrets too; never commit real values.
SERVER_NAME=codepath.example.com
DATABASE_HOST=db.example.com
DATABASE_PORT=3306
DATABASE_NAME=codepath
DATABASE_USER=codepath
JWT_ISSUER=CodePath.Api
JWT_AUDIENCE=CodePath.Client
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=codepath@example.com
SMTP_FROM_ADDRESS=no-reply@example.com
SMTP_FROM_NAME=CodePath
SMTP_SOCKET_OPTIONS=StartTls
JUDGE0_BASE_URL=http://judge0:2358

# Optional Judge integration (existing Judge0 service).
JUDGE_ENABLED=false
JUDGE_BASE_URL=http://host.docker.internal:2358/
JUDGE_API_TOKEN=

# Profiles: leave empty for Redis/API/web only; use ai or rag (rag includes AI).
# Match the feature flags to the selected profile; profiles do not set API flags.
COMPOSE_PROFILES=
AI_ENABLED=false
RAG_ENABLED=false

# Required when COMPOSE_PROFILES=ai or rag and AI_ENABLED=true.
# Keys must be separate, random, at least 32 characters.
AI_SERVICE_KEY=
AI_ANONYMIZATION_KEY=
# redis://:URL_ENCODED_PASSWORD@redis:6379/0 (same password as secrets/redis_password.txt)
AI_REDIS_URL=
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=
LLM_ADVANCED_MODEL=
LLM_BASE_URL=https://api.openai.com/v1

# Required when COMPOSE_PROFILES=rag and RAG_ENABLED=true (also AI_ENABLED=true).
QDRANT_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024
EMBEDDING_API_KEY=
RAG_MIN_SCORE=0.35
RAG_ASSET_HOSTS=api.cloudinary.com,res.cloudinary.com
