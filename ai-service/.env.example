# Set these in the process environment; no .env is loaded implicitly.
SERVICE_API_KEY=replace-with-at-least-32-random-characters
REDIS_URL=redis://localhost:6379/0
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=
LLM_ADVANCED_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
# Optional trusted classifier version; restart on change/rollback.
# MODEL_PATH=models/stage-error/v1
# MODEL_MANIFEST=models/active.json

# RAG: an embeddings endpoint compatible with POST /v1/embeddings.
# Local inference servers or a hosted service can implement this contract.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024
EMBEDDING_API_KEY=
RAG_MIN_SCORE=0.35
RAG_ASSET_HOSTS=api.cloudinary.com,res.cloudinary.com
